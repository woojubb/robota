{
  "$schema-note": "Required status checks per protected branch. Keep in sync with the GitHub rulesets.",
  "branches": {
    "develop": {
      "ruleset": "protect-develop",
      "ruleset_id": 18715844,
      "required_status_checks": [
        {
          "context": "pr-validation",
          "workflow": ".github/workflows/ci.yml",
          "job": "pr-validation",
          "verifies": "install, build, typecheck, lint, test, dependency direction, release safety checks"
        },
        {
          "context": "security",
          "workflow": ".github/workflows/ci.yml",
          "job": "security",
          "verifies": "secret scan (gitleaks) on the change range"
        }
      ]
    },
    "main": {
      "ruleset": "protect-main",
      "ruleset_id": 18715845,
      "required_status_checks": [
        {
          "context": "pr-validation",
          "workflow": ".github/workflows/ci.yml",
          "job": "pr-validation",
          "verifies": "install, build, typecheck, lint, test, dependency direction, release safety checks"
        },
        {
          "context": "security",
          "workflow": ".github/workflows/ci.yml",
          "job": "security",
          "verifies": "secret scan (gitleaks) on the change range"
        }
      ]
    }
  }
}
