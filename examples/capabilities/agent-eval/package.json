{
  "name": "robota-capability-agent-eval",
  "version": "0.1.1-beta.2",
  "private": true,
  "description": "Robota capability demo — evals-as-code: define metrics over an agent's runs and gate CI on a metric breach",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit",
    "baseline:plugin": "tsx --conditions=source src/outcome-plugin.ts",
    "baseline:browser": "tsx --conditions=source src/outcome-browser.ts",
    "test": "node --import tsx --test src/outcome-*.test.ts"
  },
  "dependencies": {
    "@robota-sdk/agent-framework": "^3.0.0-beta.89",
    "@robota-sdk/agent-provider-anthropic": "^3.0.0-beta.89",
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-mcp": "workspace:*",
    "@robota-sdk/agent-provider-replay": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
