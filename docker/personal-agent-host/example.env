# Copy to .env and fill in (the installer does this for you). Names and settings only: a model key
# never goes in this file; it is given to `personal-agent-host add` on stdin or at a hidden prompt.

# The domain accounts live under: each account is <id>.<this domain>. Its DNS (a wildcard record
# is easiest) must point at this server.
PERSONAL_AGENT_HOST_BASE_DOMAIN=agents.example.com

# The email for the public HTTPS certificates and their expiry notices; "internal" instead gives
# certificates from a local CA, for testing only.
PERSONAL_AGENT_HOST_TLS=you@example.com

# Containers share this server's kernel and have no disk quota, so this backend is for trusted
# accounts only. The control plane does not start unless this is set to true on purpose.
PERSONAL_AGENT_HOST_ALLOW_CONTAINER=true

# Optional. Ports other than 80 and 443, for a test on a machine where those are taken.
PERSONAL_AGENT_HOST_HTTP_PORT=
PERSONAL_AGENT_HOST_HTTPS_PORT=

# Optional. The pool of /29 networks for accounts (inside 10/8, 172.16/12 or 192.168/16), the
# resolvers units may reach (comma-separated; empty means this server's own), and per-unit defaults.
PERSONAL_AGENT_HOST_SUBNET_POOL=
PERSONAL_AGENT_HOST_DNS_SERVERS=
PERSONAL_AGENT_HOST_MEMORY_MB=
PERSONAL_AGENT_HOST_CPUS=
PERSONAL_AGENT_HOST_PIDS=

# Optional. The most bytes a backup archive may have, taken or restored (default 1 GiB). An archive is
# held in a private file under the state directory while it is checked, so keep that much disk free.
PERSONAL_AGENT_HOST_BACKUP_MAX_BYTES=

# Where the state lives on this server; the installer creates it owner-only.
PERSONAL_AGENT_HOST_STATE_PATH=/var/lib/personal-agent-host
# The container engine's socket on this server.
PERSONAL_AGENT_HOST_ENGINE_SOCKET=/var/run/docker.sock
