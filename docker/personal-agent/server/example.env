# Copy to .env and fill in. The provider key goes in secrets.env, not here.
PERSONAL_AGENT_DOMAIN=agent.example.com
# For the public HTTPS certificate and its expiry notices (required).
PERSONAL_AGENT_ACME_EMAIL=you@example.com
# Only for a local test with Caddy's own CA: PERSONAL_AGENT_TLS=internal
PERSONAL_AGENT_PROVIDER=openai
PERSONAL_AGENT_MODEL=deepseek/deepseek-v4.1-flash
PERSONAL_AGENT_BASE_URL=https://ai-gateway.vercel.sh/v1
PERSONAL_AGENT_API_KEY_ENV=AI_GATEWAY_API_KEY
