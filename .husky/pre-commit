#!/usr/bin/env sh

# Never commit directly to main. Approved release automation: ALLOW_PROTECTED_COMMIT=1.
BRANCH=$(git branch --show-current 2>/dev/null || echo "")
if [ "${ALLOW_PROTECTED_COMMIT:-0}" != "1" ] && [ ! -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && [ "$BRANCH" = "main" ]; then
  echo "[pre-commit] Blocked: do not commit directly to main. Create a branch first." >&2
  exit 1
fi

NODE_OPTIONS="--max-old-space-size=8192" pnpm lint:fix:staged
