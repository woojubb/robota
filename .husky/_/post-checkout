#!/usr/bin/env sh
set -e

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TARGET="$HOOK_DIR/../post-checkout"
if [ ! -x "$TARGET" ]; then
	echo "[post-checkout] Blocked: tracked hook target is missing or not executable: $TARGET" >&2
	exit 1
fi
if [ -f "$HOOK_DIR/h" ]; then
	. "$HOOK_DIR/h"
fi
exec "$TARGET" "$@"
