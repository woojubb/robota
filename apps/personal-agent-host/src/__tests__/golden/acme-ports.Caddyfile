# Generated by personal-agent-host; the control plane rewrites this file.

{
	admin unix//run/caddy/admin.sock|0600
	skip_install_trust
	email ops@example.test
	http_port 8080
	https_port 8443
	servers {
		strict_sni_host
	}
}

alice.agents.example.test {
	encode zstd gzip
	header -Server
	handle_path /ws/* {
		reverse_proxy 10.200.0.2:7361 {
			stream_close_delay 600s
		}
	}
	handle {
		reverse_proxy 10.200.0.2:7360 {
			stream_close_delay 600s
		}
	}
}

bob.agents.example.test {
	header -Server
	respond "This account is suspended." 503
}
