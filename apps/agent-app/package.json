{
  "name": "@robota-sdk/agent-app",
  "version": "3.0.14",
  "private": true,
  "description": "agent-app — the Electron shell of the robota desktop app: starts or reuses the workspace's `robota` daemon, hands its loopback address to the page, and loads the GUI web app @robota-sdk/agent-gui-web.",
  "author": "Robota",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/copy-renderer.mjs",
    "build:electron": "tsc -p electron/tsconfig.build.json && pnpm exec esbuild electron/secure-preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/secure-preload.js && node scripts/copy-product-identity.mjs && node scripts/copy-secret-window.mjs",
    "build": "pnpm build:renderer && pnpm build:electron",
    "start": "electron dist/electron/main.js",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "dist:app": "pnpm build && pnpm bundle:runtime && node scripts/prepare-desktop-build.mjs && electron-builder --config dist/electron/electron-builder.yml --publish never",
    "typecheck": "tsgo -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "xvfb-run -a node --import tsx --conditions=product-source e2e/run-e2e.mjs",
    "test:e2e:secret": "pnpm build:electron && node e2e/secret-window-e2e.mjs",
    "test:e2e:session-channel": "pnpm build:electron && node e2e/session-channel-e2e.mjs",
    "test:e2e:bundled": "node e2e/bundled-runtime-e2e.mjs",
    "test:e2e:packaged": "node e2e/packaged-app-e2e.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:e2e:remote": "node e2e/remote-runtime-e2e.mjs",
    "test:e2e:packaged-keyring": "node e2e/packaged-keyring-e2e.mjs",
    "test:e2e:owner-session": "pnpm build:electron && node e2e/desktop-owner-session-e2e.mjs",
    "test:e2e:session-admission": "pnpm build:electron && node e2e/desktop-session-admission-e2e.mjs",
    "test:e2e:secure": "node --import tsx --conditions=product-source e2e/secure-production-smoke.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@robota-sdk/agent-framework": "npm:@robota-sdk/agent-framework@3.3.2",
    "@robota-sdk/agent-gui-web": "workspace:^",
    "@robota-sdk/agent-keyring": "npm:@robota-sdk/agent-keyring@3.2.2",
    "@robota-sdk/agent-session": "npm:@robota-sdk/agent-session@3.2.8",
    "@robota-sdk/agent-ui-web": "npm:@robota-sdk/agent-ui-web@3.3.4",
    "@types/ws": "^8.18.1",
    "electron": "^43.5.0",
    "electron-builder": "26.15.7",
    "playwright": "^1.49.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@robota-sdk/agent-cli": "workspace:^",
    "@robota-sdk/agent-local-host": "workspace:^",
    "@robota-sdk/agent-transport": "npm:@robota-sdk/agent-transport@3.4.2",
    "@robota-sdk/product-config": "npm:@robota-sdk/product-config@3.2.2",
    "ws": "^8.21.1"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
