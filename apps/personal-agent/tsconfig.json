{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "noEmit": true,
    "customConditions": [
      "source"
    ],
    "paths": {
      "eventsource": [
        "./src/eventsource-types.d.ts"
      ],
      "eventsource-parser": [
        "./src/eventsource-types.d.ts"
      ],
      "eventsource-parser/stream": [
        "./src/eventsource-types.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
