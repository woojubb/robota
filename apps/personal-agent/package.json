{
  "name": "robota-personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Robota personal agent: a long-running assistant with a web UI, built by composing the Robota SDK",
  "type": "module",
  "bin": {
    "personal-agent": "./bin/personal-agent.mjs"
  },
  "scripts": {
    "personal-agent": "node bin/personal-agent.mjs",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-framework": "workspace:^",
    "@robota-sdk/agent-gui-web": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^",
    "@robota-sdk/agent-local-host": "workspace:^",
    "@robota-sdk/agent-product": "workspace:^",
    "@robota-sdk/agent-provider": "workspace:^",
    "@robota-sdk/agent-session": "workspace:^",
    "@robota-sdk/agent-tools": "workspace:^",
    "@robota-sdk/agent-transport": "workspace:^",
    "hono": "^4.12.32",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
