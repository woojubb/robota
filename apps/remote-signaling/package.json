{
  "name": "@robota-sdk/remote-signaling",
  "version": "3.0.0",
  "private": true,
  "description": "Minimal content-blind WebRTC signaling relay (SDP/ICE rendezvous) for Robota remote control",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "source": "./src/index.ts",
      "node": {
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      },
      "default": {
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "build:js": "tsdown --no-dts",
    "build:types": "tsdown --dts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^",
    "@robota-sdk/agent-remote-pairing": "workspace:^",
    "@robota-sdk/agent-transport": "workspace:^",
    "@types/node": "^22.19.21",
    "@types/ws": "^8.18.1",
    "bittorrent-dht": "^11.0.12",
    "multicast-dns": "^7.2.5",
    "node-datachannel": "^0.33.4",
    "nostr-tools": "^2.25.2",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "volta": {
    "extends": "../../package.json"
  }
}
