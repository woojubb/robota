---
import { productPublicConfig } from '../lib/product-config.generated.mjs';
const { frontmatter, lang = 'en', translationUrl = '' } = Astro.props;
const { title, subtitle, date, image, author, authorUrl } = frontmatter;
const dateLocale = lang === 'ko' ? 'ko-KR' : 'en-US';
const formattedDate = new Date(date).toLocaleDateString(dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const enUrl = lang === 'en' ? '' : translationUrl;
const koUrl = lang === 'ko' ? '' : translationUrl;
const blogUrl = productPublicConfig.identity.blogUrl;
const currentUrl = blogUrl ? `${blogUrl}${Astro.url.pathname}` : undefined;
const altLang = lang === 'en' ? 'ko' : 'en';
const measurementId = productPublicConfig.services?.analyticsMeasurementId;
---

<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {measurementId && <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script is:inline define:vars={{ measurementId }}>
      window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',measurementId);
    </script>
  </>}
  <title>{title} — {productPublicConfig.identity.displayName}</title>
  <meta name="description" content={subtitle || title} />
  {author && <meta name="author" content={author} />}
  {currentUrl && <link rel="canonical" href={currentUrl} />}
  {currentUrl && <link rel="alternate" hreflang={lang} href={currentUrl} />}
  {blogUrl && translationUrl && <link rel="alternate" hreflang={altLang} href={`${blogUrl}${translationUrl}`} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={subtitle || title} />
  <meta property="og:type" content="article" />
  {currentUrl && <meta property="og:url" content={currentUrl} />}
  <meta property="og:site_name" content={productPublicConfig.identity.displayName} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={subtitle || title} />
  {image && <meta name="twitter:image" content={image} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700;800&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      var t = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <a href={lang === 'en' ? '/' : '/ko/'} class="logo">{productPublicConfig.identity.displayName}</a>
    <nav>
      <span class="switcher">
        {enUrl ? <a href={enUrl}>EN</a> : <span class="active">EN</span>}
        <span class="sep">/</span>
        {koUrl ? <a href={koUrl}>KO</a> : <span class="active">KO</span>}
      </span>
      <span class="switcher" id="theme-toggle" role="group" aria-label="Theme">
        <span data-theme-opt="light" class="theme-opt" role="button" tabindex="0" aria-label="Light theme">☀</span>
        <span class="sep" aria-hidden="true">/</span>
        <span data-theme-opt="dark" class="theme-opt" role="button" tabindex="0" aria-label="Dark theme">☾</span>
      </span>
      <a href={lang === 'en' ? '/' : '/ko/'}>{lang === 'en' ? 'blog' : '블로그'}</a>
    </nav>
  </header>

  <main>
    <article>
      <div class="post-meta">
        <time datetime={date}>{formattedDate}</time>
        {author && <span class="author"> · {authorUrl ? <a href={authorUrl} target="_blank" rel="noopener">{author}</a> : author}</span>}
      </div>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <div class="post-content">
        <slot />
      </div>
    </article>
  </main>

  <footer class="site-footer">
    <p>
      <a href="__PROJECT_REPOSITORY_URL__">Source repository</a> ·
      <a href="__PROJECT_WEBSITE_URL__">__PROJECT_WEBSITE_HOST__</a>
    </p>
  </footer>
  <script is:inline>
    (function() {
      var toggle = document.getElementById('theme-toggle');
      function updateThemeUI() {
        var current = document.documentElement.getAttribute('data-theme');
        toggle.querySelectorAll('[data-theme-opt]').forEach(function(el) {
          el.classList.toggle('active', el.getAttribute('data-theme-opt') === current);
        });
      }
      updateThemeUI();
      toggle.addEventListener('click', function(e) {
        var opt = e.target.closest('[data-theme-opt]');
        if (!opt) return;
        var next = opt.getAttribute('data-theme-opt');
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateThemeUI();
      });
    })();
  </script>
  <script is:inline type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: true, theme: 'neutral', flowchart: { useMaxWidth: false } });
  </script>
</body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    max-width: 720px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .logo {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--green);
    text-decoration: none;
  }

  nav a {
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--text-dim);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--green);
  }

  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  .post-meta {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .author {
    color: var(--text-dim);
  }

  .author a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .author a:hover {
    color: var(--green);
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-dim);
    margin-top: -8px;
    margin-bottom: 48px;
  }

  .post-content {
    margin-top: 32px;
  }

  .site-footer {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 24px;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .site-footer p {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .site-footer a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--green);
  }

  .switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--mono);
    font-size: 0.85rem;
    margin-right: 12px;
    cursor: pointer;
  }

  .switcher a,
  .switcher .theme-opt {
    color: var(--text-muted);
    text-decoration: none;
  }

  .switcher a:hover,
  .switcher .theme-opt:hover {
    color: var(--green);
  }

  .switcher .active {
    color: var(--green);
    font-weight: 700;
    background: var(--green-bg, rgba(0, 200, 100, 0.12));
    border-radius: 4px;
    padding: 2px 6px;
  }

  .switcher .sep {
    color: var(--text-muted);
    margin: 0 1px;
  }
</style>
