# Generated product configuration contract. Product-specific values must be supplied explicitly.
# Empty required values fail. Empty optional values disable that reference.
# Relative host paths use the selected config file directory; no working-directory discovery.
# Explicit config-file selector (no alias; host-only path).
PRODUCT_CONFIG_FILE=

# identity.id: Product diagnostic identifier.
# Required; namespace; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>ID
PRODUCT_ID=

# identity.displayName: User-visible product name.
# Required; text; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>DISPLAY_NAME
PRODUCT_DISPLAY_NAME=

# identity.cliName: Installed CLI executable name.
# Required; executable name; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>CLI_NAME
PRODUCT_CLI_NAME=

# identity.envPrefix: External user-setting alias prefix; never aliases this input or config-file selection.
# Required; uppercase prefix ending in _; identity; public; consumers: build, cli, desktop, web
# Alias: none (bootstrap)
PRODUCT_ENV_PREFIX=

# identity.packageScope: External generated package scope.
# Required; npm scope; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>PACKAGE_SCOPE
PRODUCT_PACKAGE_SCOPE=

# identity.repositoryUrl: Repository URL; absent omits repository links.
# Optional; HTTP URL; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>REPOSITORY_URL
PROJECT_REPOSITORY_URL=

# identity.websiteUrl: Website URL; absent omits website links.
# Optional; HTTP URL; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>HOMEPAGE_URL
PROJECT_HOMEPAGE_URL=

# identity.docsUrl: Documentation URL; absent omits documentation links.
# Optional; HTTP URL; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>DOCS_URL
PROJECT_DOCS_URL=

# identity.blogUrl: Blog URL; absent omits blog links.
# Optional; HTTP URL; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>BLOG_URL
PROJECT_BLOG_URL=

# identity.appId: Installed desktop application identifier.
# Required; dotted application identifier; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>APP_ID
PRODUCT_APP_ID=

# identity.protocolScheme: Installed product launch URI scheme.
# Required; URI scheme; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>PROTOCOL_SCHEME
PRODUCT_PROTOCOL_SCHEME=

# identity.telemetryServiceName: Product service identity attached to telemetry resources.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>TELEMETRY_SERVICE_NAME
PRODUCT_TELEMETRY_SERVICE_NAME=

# identity.daemonNamespace: Local daemon, rendezvous and control-pipe namespace.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>DAEMON_NAMESPACE
PRODUCT_DAEMON_NAMESPACE=

# identity.desktopExecutableName: Bundled desktop runtime executable basename.
# Required; executable name; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>DESKTOP_EXECUTABLE
PRODUCT_DESKTOP_EXECUTABLE=

# identity.mcpClientName: Product identity sent to MCP servers.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>MCP_CLIENT_NAME
PRODUCT_MCP_CLIENT_NAME=

# identity.modelCommandToolPrefix: Prefix for model-visible command and result-retrieval tools.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>MODEL_TOOL_PREFIX
PRODUCT_MODEL_TOOL_PREFIX=

# identity.promptFileReferenceTag: Model-visible workspace file-reference enclosure tag.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>PROMPT_TAG
PRODUCT_PROMPT_TAG=

# identity.editorTemporaryDirectoryPrefix: Temporary editor directory prefix selected by the host.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>EDITOR_TEMP_PREFIX
PRODUCT_EDITOR_TEMP_PREFIX=

# storage.userRoot: Selected user state root; relative input is resolved against the selected file directory.
# Required; path; operational; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>USER_STATE_DIR
PRODUCT_USER_STATE_DIR=

# storage.projectDirectory: Product state directory relative to the trusted workspace.
# Required; relative directory; operational; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>PROJECT_STATE_DIR
PRODUCT_PROJECT_STATE_DIR=

# storage.cacheRoot: Selected host cache root.
# Required; path; operational; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>CACHE_DIR
PRODUCT_CACHE_DIR=

# storage.logRoot: Selected host log root.
# Required; path; operational; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>LOG_DIR
PRODUCT_LOG_DIR=

# storage.browserNamespace: Browser draft and session-restore storage namespace.
# Required; namespace; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>BROWSER_NAMESPACE
PRODUCT_BROWSER_NAMESPACE=

# storage.browserCredentialDatabase: Browser credential IndexedDB database name.
# Required; namespace; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>BROWSER_CREDENTIAL_DATABASE
PRODUCT_BROWSER_CREDENTIAL_DATABASE=

# credentials.serviceNamespace: OS credential service namespace; fixed purposes are appended by the host.
# Required; namespace; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>CREDENTIAL_SERVICE
PRODUCT_CREDENTIAL_SERVICE=

# crypto.namespace: Public cryptographic domain label shared with protocol peers; unrelated to display name or key material.
# Required; namespace; identity; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>CRYPTO_NAMESPACE
PRODUCT_CRYPTO_NAMESPACE=

# crypto.masterKeyDerivationPath: Hardened master-key child indices; the derivation implementation applies the hardened bit.
# Required; JSON integer array; identity; host; consumers: build, cli, desktop
# Alias: <PRODUCT_ENV_PREFIX>MASTER_KEY_DERIVATION_PATH
SECURITY_MASTER_KEY_DERIVATION_PATH=

# services.analyticsMeasurementId: Optional Google Analytics measurement account; absent disables site tracking.
# Optional; GA4 measurement ID; operational; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>ANALYTICS_MEASUREMENT_ID
SERVICE_ANALYTICS_MEASUREMENT_ID=

# services.signalingUrl: Signaling endpoint; required by callers before remote connectivity.
# Optional; HTTP or WebSocket URL; operational; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>SIGNALING_URL
SERVICE_SIGNALING_URL=

# services.remoteClientUrl: Browser remote client endpoint; required before generating remote-client links.
# Optional; HTTP URL; operational; public; consumers: build, cli, desktop, web
# Alias: <PRODUCT_ENV_PREFIX>REMOTE_CLIENT_URL
SERVICE_REMOTE_CLIENT_URL=

# release.artifactPrefix: Generated installation and release filename prefix.
# Optional; namespace; identity; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>ARTIFACT_PREFIX
PRODUCT_ARTIFACT_PREFIX=

# release.version: Optional pinned installation version or full release tag.
# Optional; version or tag; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>RELEASE_VERSION
PROJECT_RELEASE_VERSION=

# release.tagPrefix: Release tag prefix used in tags and workflow patterns.
# Optional; letters, numbers, dots, underscores or hyphens; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>RELEASE_TAG_PREFIX
PROJECT_RELEASE_TAG_PREFIX=

# release.channel: Release and update channel.
# Optional; namespace; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>RELEASE_CHANNEL
PROJECT_RELEASE_CHANNEL=

# release.baseUrl: Release download base URL.
# Optional; HTTP URL; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>RELEASE_BASE_URL
PROJECT_RELEASE_BASE_URL=

# release.updateMetadataUrl: Update metadata URL.
# Optional; HTTP URL; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>UPDATE_METADATA_URL
PROJECT_UPDATE_METADATA_URL=

# release.installScriptUrl: Installation script URL.
# Optional; HTTP URL; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>INSTALL_SCRIPT_URL
PROJECT_INSTALL_SCRIPT_URL=

# release.npmRegistryUrl: Explicit package publication registry.
# Optional; HTTP URL; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>NPM_REGISTRY_URL
PROJECT_NPM_REGISTRY_URL=

# release.packageAccess: Published package access policy.
# Optional; public or restricted; operational; host; consumers: build, release
# Alias: <PRODUCT_ENV_PREFIX>PACKAGE_ACCESS
PROJECT_PACKAGE_ACCESS=

# deploy.environment: Deployment environment selection.
# Optional; namespace; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>ENVIRONMENT
DEPLOY_ENVIRONMENT=

# deploy.projectName: Application deployment project.
# Optional; namespace; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>PROJECT_NAME
DEPLOY_PROJECT_NAME=

# deploy.docsProjectName: Documentation deployment project.
# Optional; namespace; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>DOCS_PROJECT_NAME
DEPLOY_DOCS_PROJECT_NAME=

# deploy.blogProjectName: Blog deployment project.
# Optional; namespace; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>BLOG_PROJECT_NAME
DEPLOY_BLOG_PROJECT_NAME=

# deploy.workerName: Worker deployment name.
# Optional; namespace; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>WORKER_NAME
DEPLOY_WORKER_NAME=

# deploy.accountId: Deployment account reference.
# Optional; text; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>ACCOUNT_ID
DEPLOY_ACCOUNT_ID=

# deploy.domain: Registered deployment domain reference.
# Optional; text; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>DOMAIN
DEPLOY_DOMAIN=

# deploy.route: Deployment route reference.
# Optional; text; operational; host; consumers: build, deploy
# Alias: <PRODUCT_ENV_PREFIX>ROUTE
DEPLOY_ROUTE=
