{
  "name": "@robota-sdk/agent-framework",
  "version": "3.3.0",
  "description": "Programmatic SDK for building AI agents with Robota — provides InteractiveSession, createQuery(), command APIs, permissions, hooks, and context loading",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "source": "./src/node.ts",
      "browser": null,
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "scenario:verify": "pnpm scenario:verify:external-payload && pnpm scenario:verify:runtime-session-store && pnpm scenario:verify:prompt-resolution && pnpm scenario:verify:zero-config-tools && pnpm scenario:verify:workspace-authority && pnpm scenario:verify:memory-recall-provenance && pnpm scenario:verify:fork-record-persistence",
    "scenario:verify:external-payload": "pnpm exec tsx --conditions=source examples/verify-session-log-external-payload-replay.ts",
    "scenario:verify:runtime-session-store": "pnpm exec tsx --conditions=source examples/verify-runtime-session-store.ts",
    "scenario:verify:prompt-resolution": "pnpm exec tsx --conditions=source examples/verify-prompt-request-resolution.ts",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh",
    "scenario:verify:zero-config-tools": "pnpm exec tsx --conditions=source examples/verify-zero-config-default-tools.ts",
    "scenario:verify:workspace-authority": "pnpm exec tsx --conditions=source examples/verify-workspace-project-authority.ts",
    "scenario:verify:memory-recall-provenance": "pnpm exec tsx --conditions=source examples/verify-memory-recall-provenance.ts",
    "scenario:verify:fork-record-persistence": "pnpm exec tsx examples/verify-fork-record-persistence.ts",
    "scenario:verify:outcomes": "pnpm exec tsx --conditions=source examples/verify-outcome-baseline.ts && pnpm exec tsx --conditions=source examples/verify-outcome-cancel-resume.ts && pnpm exec tsx --conditions=source examples/verify-outcome-memory.ts"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-executor": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^",
    "@robota-sdk/agent-os": "workspace:^",
    "@robota-sdk/agent-roundtable": "workspace:^",
    "@robota-sdk/agent-session": "workspace:^",
    "@robota-sdk/agent-tools": "workspace:^",
    "koffi": "3.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@robota-sdk/agent-provider": "workspace:^",
    "@robota-sdk/agent-provider-replay": "workspace:^",
    "@robota-sdk/agent-session-analytics": "workspace:^",
    "@robota-sdk/agent-transport": "workspace:^",
    "openai": "^6.0.0",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "ai",
    "agent",
    "sdk",
    "llm",
    "anthropic",
    "openai",
    "gemini",
    "typescript",
    "agent-framework",
    "ai-agent",
    "tool-use",
    "multi-provider",
    "embedded-agent",
    "interactive-session",
    "robota"
  ],
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
