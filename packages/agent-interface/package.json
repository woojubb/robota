{
  "name": "@robota-sdk/agent-interface",
  "version": "3.3.1",
  "description": "Type contracts for the Robota SDK, one subpath per family: session, session-mobility, command, execution, analytics, transport and tui",
  "type": "module",
  "exports": {
    "./analytics": {
      "source": "./src/analytics/index.ts",
      "import": {
        "types": "./dist/analytics/index.d.ts",
        "default": "./dist/analytics/index.js"
      },
      "require": {
        "types": "./dist/analytics/index.d.cts",
        "default": "./dist/analytics/index.cjs"
      }
    },
    "./command": {
      "source": "./src/command/index.ts",
      "import": {
        "types": "./dist/command/index.d.ts",
        "default": "./dist/command/index.js"
      },
      "require": {
        "types": "./dist/command/index.d.cts",
        "default": "./dist/command/index.cjs"
      }
    },
    "./execution": {
      "source": "./src/execution/index.ts",
      "import": {
        "types": "./dist/execution/index.d.ts",
        "default": "./dist/execution/index.js"
      },
      "require": {
        "types": "./dist/execution/index.d.cts",
        "default": "./dist/execution/index.cjs"
      }
    },
    "./session": {
      "source": "./src/session/index.ts",
      "import": {
        "types": "./dist/session/index.d.ts",
        "default": "./dist/session/index.js"
      },
      "require": {
        "types": "./dist/session/index.d.cts",
        "default": "./dist/session/index.cjs"
      }
    },
    "./session-mobility": {
      "source": "./src/session-mobility/index.ts",
      "import": {
        "types": "./dist/session-mobility/index.d.ts",
        "default": "./dist/session-mobility/index.js"
      },
      "require": {
        "types": "./dist/session-mobility/index.d.cts",
        "default": "./dist/session-mobility/index.cjs"
      }
    },
    "./session/testing": {
      "source": "./src/session/testing/index.ts",
      "import": {
        "types": "./dist/session/testing/index.d.ts",
        "default": "./dist/session/testing/index.js"
      },
      "require": {
        "types": "./dist/session/testing/index.d.cts",
        "default": "./dist/session/testing/index.cjs"
      }
    },
    "./transport": {
      "source": "./src/transport/index.ts",
      "import": {
        "types": "./dist/transport/index.d.ts",
        "default": "./dist/transport/index.js"
      },
      "require": {
        "types": "./dist/transport/index.d.cts",
        "default": "./dist/transport/index.cjs"
      }
    },
    "./transport/testing": {
      "source": "./src/transport/testing/index.ts",
      "import": {
        "types": "./dist/transport/testing/index.d.ts",
        "default": "./dist/transport/testing/index.js"
      },
      "require": {
        "types": "./dist/transport/testing/index.d.cts",
        "default": "./dist/transport/testing/index.cjs"
      }
    },
    "./tui": {
      "source": "./src/tui/index.ts",
      "import": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui/index.js"
      },
      "require": {
        "types": "./dist/tui/index.d.cts",
        "default": "./dist/tui/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "peerDependencies": {
    "@robota-sdk/agent-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@robota-sdk/agent-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "volta": {
    "extends": "../../package.json"
  }
}
