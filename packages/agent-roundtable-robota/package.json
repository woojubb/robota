{
  "name": "@robota-sdk/agent-roundtable-robota",
  "version": "3.0.0-beta.86",
  "description": "Run Robota Session and Robota agents as agent-roundtable participants and selectors",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./session": {
      "source": "./src/session.ts",
      "import": {
        "types": "./dist/session.d.ts",
        "default": "./dist/session.js"
      },
      "require": {
        "types": "./dist/session.d.cts",
        "default": "./dist/session.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-roundtable": "workspace:*"
  },
  "peerDependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@robota-sdk/agent-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-session": "workspace:*",
    "@robota-sdk/agent-tool-defaults": "workspace:*",
    "tsdown": "^0.22.14",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/woojubb/robota.git",
    "directory": "packages/agent-roundtable-robota"
  },
  "homepage": "https://docs.robota.io/en/packages/agent-roundtable-robota/",
  "bugs": {
    "url": "https://github.com/woojubb/robota/issues"
  }
}
