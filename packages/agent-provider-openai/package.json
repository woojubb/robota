{
  "name": "@robota-sdk/agent-provider-openai",
  "version": "3.0.7",
  "description": "OpenAI provider implementation for Robota SDK",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./loggers": {
      "source": "./src/openai/loggers/index.ts",
      "import": {
        "types": "./dist/loggers/index.d.ts",
        "default": "./dist/loggers/index.js"
      },
      "require": {
        "types": "./dist/loggers/index.d.cts",
        "default": "./dist/loggers/index.cjs"
      }
    },
    "./node": {
      "source": "./src/node.ts",
      "browser": null,
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "scenario:verify": "pnpm typecheck",
    "scenario:verify:tool-schema-projection": "pnpm exec tsx --conditions=source examples/verify-tool-schema-projection.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-provider-openai-compatible": "workspace:*",
    "openai": "^6.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
