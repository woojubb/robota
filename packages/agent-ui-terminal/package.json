{
  "name": "@robota-sdk/agent-ui-terminal",
  "version": "3.0.0-beta.82",
  "description": "Terminal UI package (React + Ink) for the Robota SDK",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woojubb/robota.git"
  },
  "homepage": "https://robota.io/",
  "bugs": {
    "url": "https://github.com/woojubb/robota/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "scenario:verify": "pnpm exec tsx --conditions=source examples/verify-session-event-rendering.ts",
    "test:pty": "vitest run --config vitest.pty.config.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-framework": "workspace:*",
    "@robota-sdk/agent-interface-analytics": "workspace:*",
    "@robota-sdk/agent-interface-command": "workspace:*",
    "@robota-sdk/agent-interface-execution": "workspace:*",
    "@robota-sdk/agent-interface-session": "workspace:*",
    "@robota-sdk/agent-interface-transport": "workspace:*",
    "@robota-sdk/agent-interface-tui": "workspace:*",
    "@robota-sdk/agent-transport": "workspace:*",
    "chalk": "^5.6.2",
    "ink": "^7.1.1",
    "marked": "^9.1.6",
    "marked-terminal": "^7.3.0",
    "react": "19.2.8",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@robota-sdk/agent-command": "workspace:*",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
