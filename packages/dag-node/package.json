{
  "name": "@robota-sdk/dag-node",
  "version": "3.0.0-beta.61",
  "private": true,
  "description": "AbstractNodeDefinition base class for Robota DAG workflow nodes",
  "type": "module",
  "main": "dist/node/index.js",
  "module": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "keywords": [
    "robota",
    "dag",
    "node",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "agent-workflow",
    "workflow-orchestration",
    "llm-pipeline",
    "claude",
    "anthropic",
    "openai",
    "gemini",
    "typescript"
  ],
  "dependencies": {
    "@robota-sdk/dag-core": "workspace:*",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "volta": {
    "extends": "../../package.json"
  }
}
