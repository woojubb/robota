{
  "name": "@robota-sdk/dag-adapters-local",
  "version": "3.0.0-beta.61",
  "private": true,
  "description": "Local adapter implementations for DAG ports (in-memory and file-based)",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/node/testing/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/testing/index.d.ts",
          "default": "./dist/node/testing/index.js"
        },
        "require": {
          "types": "./dist/node/testing/index.d.cts",
          "default": "./dist/node/testing/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/testing/index.d.ts",
          "default": "./dist/node/testing/index.js"
        },
        "require": {
          "types": "./dist/node/testing/index.d.cts",
          "default": "./dist/node/testing/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/dag-core": "workspace:*",
    "@robota-sdk/dag-cost": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
