{
  "name": "@robota-sdk/agent-provider-replay",
  "version": "3.0.12",
  "description": "Deterministic AI provider that replays a recorded Robota session log (offline, no model key)",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "browser": null,
      "product-source": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "npm:@robota-sdk/agent-core@3.2.3",
    "@robota-sdk/agent-session": "npm:@robota-sdk/agent-session@3.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "private": true,
  "volta": {
    "extends": "../../package.json"
  }
}
