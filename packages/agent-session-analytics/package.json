{
  "name": "@robota-sdk/agent-session-analytics",
  "version": "3.2.6",
  "description": "Pure analysis of persisted session records for the Robota SDK: turn timing, source-attributed token usage and cost, personal usage reports, OTLP usage, trace and event payloads, and text reports",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsgo --noEmit",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
