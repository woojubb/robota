{
  "name": "@robota-sdk/agent-cli",
  "version": "3.2.2",
  "description": "robota — a coding-capable terminal agent built from the same foundation as the Robota SDK",
  "type": "module",
  "bin": {
    "robota": "./bin/agent.cjs"
  },
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "browser": null,
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        }
      }
    },
    "./host": {
      "source": "./src/product-host.ts",
      "browser": null,
      "import": {
        "types": "./dist/node/host.d.ts",
        "default": "./dist/node/host.js"
      }
    },
    "./desktop-host": {
      "source": "./src/desktop-host.ts",
      "browser": null,
      "import": {
        "types": "./dist/node/desktop-host.d.ts",
        "default": "./dist/node/desktop-host.js"
      }
    },
    "./native-build": {
      "browser": null,
      "import": {
        "types": "./scripts/native-build.d.mts",
        "default": "./scripts/native-build.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "bin",
    "scripts/native-build.mjs",
    "scripts/native-build.d.mts",
    "scripts/koffi-bun-plugin.mjs",
    "scripts/qualify-koffi-gc.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown && node scripts/copy-web.mjs",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "dev": "tsx src/bin.ts",
    "start": "node dist/node/bin.js",
    "test": "vitest run --passWithNoTests",
    "test:bin": "vitest run --config vitest.bin.config.ts",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "clean": "rimraf dist",
    "demo:record": "node scripts/record-demo.mjs",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh",
    "build:bun": "bun scripts/build-bun.mjs",
    "build:bun:darwin-arm64": "bun scripts/build-bun.mjs darwin-arm64",
    "build:bun:darwin-x64": "bun scripts/build-bun.mjs darwin-x64",
    "build:bun:linux-x64": "bun scripts/build-bun.mjs linux-x64",
    "build:bun:linux-arm64": "bun scripts/build-bun.mjs linux-arm64",
    "build:bun:windows-x64": "bun scripts/build-bun.mjs windows-x64",
    "scenario:verify": "pnpm exec tsx --conditions=product-source examples/verify-session-event-delivery.ts",
    "scenario:usage:verify": "pnpm exec tsx --conditions=product-source examples/verify-personal-usage.ts",
    "scenario:verify:mcp-background": "pnpm exec tsx --conditions=product-source examples/verify-mcp-background.ts",
    "scenario:verify:mcp-result-admission": "pnpm exec tsx --conditions=product-source examples/verify-mcp-result-admission.ts",
    "build:bun:headless": "bun scripts/build-bun.mjs headless",
    "build:bun:headless:darwin-arm64": "bun scripts/build-bun.mjs headless darwin-arm64",
    "build:bun:headless:darwin-x64": "bun scripts/build-bun.mjs headless darwin-x64",
    "build:bun:headless:linux-x64": "bun scripts/build-bun.mjs headless linux-x64",
    "build:bun:headless:linux-arm64": "bun scripts/build-bun.mjs headless linux-arm64",
    "build:bun:headless:windows-x64": "bun scripts/build-bun.mjs headless windows-x64",
    "test:bun:headless": "node scripts/e2e-headless-binary.mjs"
  },
  "comment:dependencies": "The CLI bundles its pinned SDK dependencies and private product modules. Runtime dependencies are third-party packages kept external.",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@anthropic-ai/sdk": "^0.114.0",
    "@google/genai": "^1.52.0",
    "@hono/node-server": "^2.0.11",
    "@marcbachmann/cel-js": "^7.5.3",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "bittorrent-dht": "^11.0.12",
    "chalk": "^5.6.2",
    "croner": "^10.0.1",
    "fast-glob": "^3.3.3",
    "hono": "^4.12.32",
    "ink": "^7.1.1",
    "jssha": "^3.3.2",
    "koffi": "3.3.1",
    "marked": "^9.1.6",
    "marked-terminal": "^7.3.0",
    "multicast-dns": "^7.2.5",
    "nostr-tools": "^2.25.2",
    "openai": "^6.0.0",
    "p-limit": "^7.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "string-width": "^8.2.2",
    "ws": "^8.21.1",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.24.6"
  },
  "peerDependencies": {
    "e2b": "2.51.0"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "node-datachannel": "^0.33.4"
  },
  "devDependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@robota-sdk/agent-core": "npm:@robota-sdk/agent-core@3.2.3",
    "@robota-sdk/agent-executor": "npm:@robota-sdk/agent-executor@3.2.4",
    "@robota-sdk/agent-framework": "npm:@robota-sdk/agent-framework@3.2.5",
    "@robota-sdk/agent-gui-web": "workspace:^",
    "@robota-sdk/agent-interface": "npm:@robota-sdk/agent-interface@3.3.0",
    "@robota-sdk/agent-keyring": "npm:@robota-sdk/agent-keyring@3.2.1",
    "@robota-sdk/agent-local-host": "workspace:^",
    "@robota-sdk/agent-mcp": "npm:@robota-sdk/agent-mcp@3.2.2",
    "@robota-sdk/agent-organization-host": "workspace:^",
    "@robota-sdk/agent-os": "npm:@robota-sdk/agent-os@3.3.0",
    "@robota-sdk/agent-product": "npm:@robota-sdk/agent-product@3.3.1",
    "@robota-sdk/agent-provider": "npm:@robota-sdk/agent-provider@3.3.1",
    "@robota-sdk/agent-provider-replay": "workspace:^",
    "@robota-sdk/agent-remote-pairing": "npm:@robota-sdk/agent-remote-pairing@3.2.3",
    "@robota-sdk/agent-session": "npm:@robota-sdk/agent-session@3.2.5",
    "@robota-sdk/agent-session-analytics": "npm:@robota-sdk/agent-session-analytics@3.2.5",
    "@robota-sdk/agent-subagent-runner": "npm:@robota-sdk/agent-subagent-runner@3.2.5",
    "@robota-sdk/agent-telemetry-otel": "npm:@robota-sdk/agent-telemetry-otel@3.2.4",
    "@robota-sdk/agent-tools": "npm:@robota-sdk/agent-tools@3.3.1",
    "@robota-sdk/agent-transport": "npm:@robota-sdk/agent-transport@3.4.1",
    "@robota-sdk/agent-ui-terminal": "npm:@robota-sdk/agent-ui-terminal@3.2.4",
    "@robota-sdk/product-config": "npm:@robota-sdk/product-config@3.2.1",
    "@robota-sdk/workflows": "0.0.6",
    "@types/marked": "^6.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "@xterm/xterm": "^5.5.0",
    "e2b": "2.51.0",
    "gifenc": "^1.0.3",
    "jose": "6.2.3",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "agent",
    "llm",
    "anthropic",
    "openai",
    "claude",
    "typescript",
    "developer-tools",
    "terminal",
    "automation",
    "multi-provider",
    "robota",
    "open-source"
  ],
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
