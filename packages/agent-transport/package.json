{
  "name": "@robota-sdk/agent-transport",
  "version": "3.0.0-beta.79",
  "description": "Transport package boundary for Robota SDK — runtime hosts are owned by agent-framework",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/node/index.d.ts",
      "node": {
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      },
      "browser": {
        "import": "./dist/browser/index.js"
      },
      "default": {
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      }
    },
    "./client": {
      "types": "./dist/browser/client.d.ts",
      "source": "./src/client.ts",
      "browser": "./dist/browser/client.js",
      "import": "./dist/browser/client.js",
      "default": "./dist/browser/client.js"
    },
    "./node": {
      "types": "./dist/node/node.d.ts",
      "source": "./src/node/index.ts",
      "node": {
        "import": "./dist/node/node.js",
        "require": "./dist/node/node.cjs"
      },
      "browser": null,
      "default": {
        "import": "./dist/node/node.js",
        "require": "./dist/node/node.cjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woojubb/robota.git"
  },
  "homepage": "https://robota.io/",
  "bugs": {
    "url": "https://github.com/woojubb/robota/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-interface-analytics": "workspace:*",
    "@robota-sdk/agent-interface-command": "workspace:*",
    "@robota-sdk/agent-interface-execution": "workspace:*",
    "@robota-sdk/agent-interface-session": "workspace:*",
    "@robota-sdk/agent-interface-session-mobility": "workspace:*",
    "@robota-sdk/agent-interface-transport": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
