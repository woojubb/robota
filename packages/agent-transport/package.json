{
  "name": "@robota-sdk/agent-transport",
  "version": "3.4.1",
  "description": "Carrier-neutral wire protocol, session dispatch and delivery for Robota SDK transports, plus one subpath per carrier: ws, http, mcp, acp, webrtc and link",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "source": "./src/client.ts",
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./node": {
      "source": "./src/node/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./ws": {
      "source": "./src/ws/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/ws/index.d.ts",
        "default": "./dist/ws/index.js"
      },
      "require": {
        "types": "./dist/ws/index.d.cts",
        "default": "./dist/ws/index.cjs"
      }
    },
    "./http": {
      "source": "./src/http/index.ts",
      "import": {
        "types": "./dist/http/index.d.ts",
        "default": "./dist/http/index.js"
      },
      "require": {
        "types": "./dist/http/index.d.cts",
        "default": "./dist/http/index.cjs"
      }
    },
    "./mcp": {
      "source": "./src/mcp/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "require": {
        "types": "./dist/mcp/index.d.cts",
        "default": "./dist/mcp/index.cjs"
      }
    },
    "./acp": {
      "source": "./src/acp/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/acp/index.d.ts",
        "default": "./dist/acp/index.js"
      },
      "require": {
        "types": "./dist/acp/index.d.cts",
        "default": "./dist/acp/index.cjs"
      }
    },
    "./webrtc": {
      "source": "./src/webrtc/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/webrtc/index.d.ts",
        "default": "./dist/webrtc/index.js"
      },
      "require": {
        "types": "./dist/webrtc/index.d.cts",
        "default": "./dist/webrtc/index.cjs"
      }
    },
    "./link": {
      "source": "./src/link/index.ts",
      "browser": null,
      "import": {
        "types": "./dist/link/index.d.ts",
        "default": "./dist/link/index.js"
      },
      "require": {
        "types": "./dist/link/index.d.cts",
        "default": "./dist/link/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh",
    "lint": "eslint src/ --ext .ts",
    "scenario:verify": "pnpm exec tsx --conditions=source examples/verify-outbound-delivery-boundary.ts",
    "smoke:link": "node scripts/smoke.mjs",
    "smoke:bun:link": "bun scripts/smoke.mjs"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^",
    "jose": "6.2.3"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@robota-sdk/agent-keyring": "workspace:^",
    "@robota-sdk/agent-remote-pairing": "workspace:^",
    "bittorrent-dht": "^11.0.12",
    "hono": "^4.12.32",
    "multicast-dns": "^7.2.5",
    "node-datachannel": "^0.33.4",
    "nostr-tools": "^2.25.2",
    "ws": "^8.21.1",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@agentclientprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/node": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@robota-sdk/agent-keyring": {
      "optional": true
    },
    "@robota-sdk/agent-remote-pairing": {
      "optional": true
    },
    "bittorrent-dht": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "multicast-dns": {
      "optional": true
    },
    "node-datachannel": {
      "optional": true
    },
    "nostr-tools": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@robota-sdk/agent-keyring": "workspace:^",
    "@robota-sdk/agent-remote-pairing": "workspace:^",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "bittorrent-dht": "^11.0.12",
    "hono": "^4.12.32",
    "multicast-dns": "^7.2.5",
    "node-datachannel": "^0.33.4",
    "nostr-tools": "^2.25.2",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6",
    "ws": "^8.21.1",
    "zod": "^4.6.7"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
