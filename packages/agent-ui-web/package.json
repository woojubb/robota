{
  "name": "@robota-sdk/agent-ui-web",
  "version": "3.0.0-beta.82",
  "description": "GUI presentation layer for a robota session — React components + a wire-protocol session reducer + a desktop shell, rendered over the transport-neutral TServerMessage stream. The GUI analog of agent-ui-terminal; consumed by the GUI web app (packages/agent-gui-web — loaded by the desktop app and served by the CLI), and the browser remote surface (agent-transport-webrtc-web + apps/agent-web /remote).",
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "private": true,
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      },
      "default": "./dist/node/index.js"
    },
    "./client": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "default": "./dist/browser/index.js"
    },
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@robota-sdk/agent-interface-command": "workspace:*",
    "@robota-sdk/agent-interface-execution": "workspace:*",
    "@robota-sdk/agent-interface-session": "workspace:*",
    "@robota-sdk/agent-interface-transport": "workspace:*",
    "@robota-sdk/agent-transport": "workspace:*",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
