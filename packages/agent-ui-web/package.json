{
  "name": "@robota-sdk/agent-ui-web",
  "version": "3.3.2",
  "description": "Browser-safe React session presentation, wire reducer, WebSocket client and runtime-host contract for consumer-owned agent renderers.",
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./client": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./styles/theme.css": {
      "types": "./src/styles/theme.css.d.mts",
      "style": "./src/styles/theme.css",
      "browser": "./src/styles/theme.css",
      "import": "./src/styles/theme.css"
    },
    "./styles/surface.css": {
      "types": "./src/styles/surface.css.d.mts",
      "style": "./src/styles/surface.css",
      "browser": "./src/styles/surface.css",
      "import": "./src/styles/surface.css"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/testing/**",
    "README.md",
    "docs/README.md",
    "docs/SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:^",
    "@robota-sdk/agent-interface": "workspace:^",
    "@robota-sdk/agent-transport": "workspace:^",
    "lucide-react": "^1.26.0",
    "pretendard": "^1.3.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
