{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
