{
  "name": "@robota-sdk/agent-executor",
  "version": "3.0.0-beta.82",
  "description": "Composable runtime primitives for Robota background tasks and subagent orchestration",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/woojubb/robota.git",
    "directory": "packages/agent-executor"
  },
  "homepage": "https://robota.io/",
  "bugs": {
    "url": "https://github.com/woojubb/robota/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "dev": "tsdown --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "scenario:verify": "pnpm exec tsx --conditions=source examples/verify-shell-resolution-contract.ts",
    "scenario:verify:windows-shell": "pnpm exec tsx --conditions=source examples/verify-windows-shell-runners.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.examples.json --noEmit",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "keywords": [
    "ai",
    "agent",
    "runtime",
    "background-tasks",
    "subagents",
    "typescript",
    "robota"
  ],
  "author": "Robota SDK Team",
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-interface-execution": "workspace:*",
    "@robota-sdk/agent-interface-transport": "workspace:*",
    "@robota-sdk/agent-process": "workspace:*",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "volta": {
    "extends": "../../package.json"
  }
}
