{
  "name": "@robota-sdk/agent-command-workflows",
  "version": "3.0.0-beta.5",
  "private": true,
  "description": "agent-cli /workflows command module — surfaces the DAG workflow engine by composing dag-framework",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:live": "RUN_LIVE_LLM=1 vitest run src/__tests__/create-command.live.test.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-core": "workspace:*",
    "@robota-sdk/agent-framework": "workspace:*",
    "@robota-sdk/agent-interface-command": "workspace:*",
    "@robota-sdk/dag-builder": "workspace:*",
    "@robota-sdk/dag-core": "workspace:*",
    "@robota-sdk/dag-framework": "workspace:*",
    "@robota-sdk/dag-node": "workspace:*",
    "@robota-sdk/dag-node-instant-node": "workspace:*",
    "@robota-sdk/dag-nodes-default": "workspace:*"
  },
  "devDependencies": {
    "@robota-sdk/agent-builtin-providers": "workspace:*",
    "@types/node": "^22.19.21",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
