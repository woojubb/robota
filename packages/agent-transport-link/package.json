{
  "name": "@robota-sdk/agent-transport-link",
  "version": "3.2.2",
  "description": "Owner-link carrier for the Robota SDK: the owner link handshake, sealed frames and the owner vocabulary over a local byte stream",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "dist/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "browser": null,
      "node": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/index.d.ts",
          "default": "./dist/node/index.js"
        },
        "require": {
          "types": "./dist/node/index.d.cts",
          "default": "./dist/node/index.cjs"
        }
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsdown",
    "build:js": "pnpm run build",
    "build:types": "pnpm run build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src/ --ext .ts",
    "clean": "rimraf dist",
    "smoke": "node scripts/smoke.mjs",
    "smoke:bun": "bun scripts/smoke.mjs",
    "prepublishOnly": "bash ../../scripts/check-pnpm-publish.sh"
  },
  "dependencies": {
    "@robota-sdk/agent-interface-session": "workspace:^",
    "@robota-sdk/agent-keyring": "workspace:^",
    "@robota-sdk/agent-transport": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "tsdown": "^0.22.14",
    "vitest": "^3.2.6"
  },
  "license": "AGPL-3.0-only OR LicenseRef-Commercial",
  "publishConfig": {
    "access": "public"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
