graph TD
  %% Package dependency graph of the Robota monorepo.
  %% An arrow A --> B means "B depends on A" (A is used by B). Dotted arrows are runtime
  %% relations, not package dependencies. Grouped boxes stand for several packages.

  subgraph Leaves["Leaves (no @robota-sdk dependency)"]
    OS[agent-os<br/>file-authority · node-lock · process]
    KR[agent-keyring<br/>key custody and sealing]
    PAIR[agent-remote-pairing]
    RT[agent-roundtable<br/>turn scheduling, no runtime]
  end

  subgraph Foundation["Foundation"]
    CORE[agent-core<br/>Robota engine · tool/plugin/provider contracts · permissions]
  end

  subgraph Contracts["agent-interface (type-only contracts)"]
    IF[agent-interface<br/>one subpath per family]
  end

  subgraph Blocks["Building blocks"]
    TOOLS[agent-tools<br/>+ ./defaults default tool set]
    PLUG[agent-plugin]
    MCP[agent-mcp<br/>MCP client]
    PROV[agent-provider<br/>one subpath per vendor + builtin]
    SA[agent-session-analytics]
    OTEL[agent-telemetry-otel<br/>OTel span and metric projection]
  end

  subgraph Runtime["Runtime"]
    SESS[agent-session]
    REPLAY[agent-provider-replay<br/>private · test replay]
    EXEC[agent-executor]
    RTR[agent-roundtable-robota<br/>Session/Robota roundtable participants]
  end

  subgraph Assembly["Assembly"]
    FW[agent-framework<br/>InteractiveSession · createQuery · createAgentRuntime · startRuntimeHost]
  end

  subgraph Transports["Transports"]
    TCORE[agent-transport<br/>wire protocol · delivery]
    TCAR[agent-transport/ws · /mcp · /acp]
    THTTP[agent-transport/http]
    TWEBRTC[agent-transport/webrtc]
    TLINK[agent-transport/link<br/>owner link carrier]
  end

  subgraph Presentation["Presentation"]
    TTUI[agent-ui-terminal<br/>React + Ink]
    TGUI[agent-ui-web · agent-gui-web ·<br/>private]
  end

  subgraph Composition["Product composition"]
    SUB[agent-subagent-runner]
    PROD[agent-product<br/>assembleProduct + capability-pack · preset · command · coding subpaths]
  end

  WF["External @robota-sdk/workflows/command"]

  subgraph Surfaces["Composition roots"]
    CLI[packages/agent-cli<br/>robota · self-contained bundle]
    APP[apps/agent-app<br/>Electron desktop app]
    WEB[apps/agent-web<br/>browser remote client]
    STARTER[apps/starter-nextjs]
    SIG[apps/remote-signaling]
    ACTION[apps/action]
  end

  %% Contracts
  CORE --> IF

  %% Building blocks
  CORE --> TOOLS & PLUG & MCP & PROV & SA
  OS --> TOOLS
  IF --> SA
  IF & CORE --> OTEL

  %% Runtime
  CORE --> SESS & EXEC
  CORE & SESS --> REPLAY
  OS --> SESS
  IF --> SESS
  OS --> EXEC
  IF --> EXEC
  CORE & SESS & RT --> RTR

  %% Assembly (providers are injected by the composition root, never imported)
  CORE & SESS & EXEC & TOOLS & OS & RT --> FW
  IF --> FW
  PROV -. injected .-> FW

  %% Transports
  CORE & IF --> TCORE
  TCORE --> TCAR & THTTP & TWEBRTC
  TCORE & KR --> TLINK
  PAIR --> TWEBRTC

  %% Presentation
  FW & TCORE & IF --> TTUI
  TCORE & PAIR --> TGUI

  %% Product composition
  FW --> SUB & PROD
  TOOLS --> PROD
  EXEC & OS --> SUB

  CORE & FW --> WF

  %% Composition roots
  FW & PROD & SUB & MCP & PROV & SA --> CLI
  TTUI & TCAR & TWEBRTC & TGUI & WF --> CLI
  KR --> CLI
  TGUI --> APP
  CLI -. daemon over loopback WebSocket .-> APP
  TGUI --> WEB
  FW & PROV --> STARTER
  TWEBRTC --> SIG
  CLI -. runs .-> ACTION
